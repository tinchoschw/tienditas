rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'yunior@gmail.com';
    }

    function isStoreOwner(storeData) {
      return isSignedIn() && 
        request.auth.token.email != null && 
        storeData.ownerEmail != null && 
        request.auth.token.email.lower() == storeData.ownerEmail.lower();
    }

    // STORES COLLECTION
    match /stores/{storeId} {
      // Lectura pública de perfiles de tiendas
      allow read: if true;
      
      // Registro de tiendas: usuarios autenticados pueden crear su propia tienda trial
      allow create: if isSuperAdmin() || (
        isSignedIn() && 
        request.resource.data.ownerEmail != null &&
        request.auth.token.email != null &&
        request.resource.data.ownerEmail.lower() == request.auth.token.email.lower() &&
        request.resource.data.plan == 'trial' &&
        request.resource.data.status == 'active'
      );
      
      // Actualización de tiendas: Superadmin o dueño (sin poder alterar plan, vencimiento ni email)
      allow update: if isSuperAdmin() || (
        isStoreOwner(resource.data) &&
        request.resource.data.plan == resource.data.plan &&
        request.resource.data.planEndsAt == resource.data.planEndsAt &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        (
          request.resource.data.status == resource.data.status ||
          request.resource.data.status == 'closed'
        )
      );
      
      allow delete: if isSuperAdmin();
      
      // PERIODOS DE PAGO:
      // Lectura para dueño o Superadmin; escritura solo Superadmin
      match /periods/{periodId} {
        allow read: if isSuperAdmin() || isStoreOwner(get(/databases/$(database)/documents/stores/$(storeId)).data);
        allow write: if isSuperAdmin();
      }

      // CONFIGURACIÓN DE TIENDA:
      // Lectura pública; escritura solo dueño o Superadmin
      match /settings/{docId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isStoreOwner(get(/databases/$(database)/documents/stores/$(storeId)).data);
      }
      
      // PRODUCTOS DE TIENDA:
      // Lectura pública; escritura solo dueño o Superadmin
      match /products/{productId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isStoreOwner(get(/databases/$(database)/documents/stores/$(storeId)).data);
      }
      
      // VENTAS DE TIENDA:
      // Checkout público puede crear ventas (allow create)
      // Lectura, actualización y borrado SOLO para el dueño de la tienda o superadmin
      match /sales/{saleId} {
        allow create: if true;
        allow read, update, delete: if isSuperAdmin() || isStoreOwner(get(/databases/$(database)/documents/stores/$(storeId)).data);
      }

      // DOCUMENTOS PRIVADOS:
      // Tokens de Mercado Pago y secretos de backend.
      // Inaccesible para el frontend (allow read, write: if false;), solo accesible vía firebase-admin.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // ESTADOS OAUTH MERCADO PAGO:
    // Exclusivo para el backend con firebase-admin (allow read, write: if false;)
    match /oauthStates/{document=**} {
      allow read, write: if false;
    }

    // CONFIGURACIÓN GLOBAL DE PLATAFORMA (PRECIOS Y SOPORTE)
    match /platformConfig/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // FEEDBACK DE CIERRE Y FRIENDS & FAMILY
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, delete, update: if isSuperAdmin();
    }

    // COLECCIONES LEGACY
    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /sales/{saleId} {
      allow read, write: if isSuperAdmin();
    }
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }
  }
}
