# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_BASE_URL: Base URL of the application.
PUBLIC_BASE_URL="https://tienditas.ai.studio"

# MERCADOPAGO_APP_ID: Application ID from Mercado Pago Developers
MERCADOPAGO_APP_ID="1254765898303511"

# MERCADOPAGO_CLIENT_SECRET: Client Secret for OAuth token exchange
MERCADOPAGO_CLIENT_SECRET="tu_client_secret"

# MERCADOPAGO_PUBLIC_KEY: Public key for client-side checkout
MERCADOPAGO_PUBLIC_KEY="tu_public_key_aqui"

# MERCADOPAGO_ACCESS_TOKEN: Access token for server-side preference creation
MERCADOPAGO_ACCESS_TOKEN="tu_access_token_aqui"

# SUPERADMIN_PASSWORD: Password for SuperAdmin panel access
SUPERADMIN_PASSWORD="tu_superadmin_password_aqui"
