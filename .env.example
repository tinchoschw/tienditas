# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PUBLIC_BASE_URL: Base URL of the application.
PUBLIC_BASE_URL="https://tienditas.ai.studio"

# SUPERADMIN_PASSWORD: Password for SuperAdmin panel access
SUPERADMIN_PASSWORD="tu_superadmin_password_aqui"

# ========================================================
# MERCADO PAGO - CREDENCIALES SEPARADAS POR ENTORNO
# ========================================================

# 1. PRODUCCIÓN (Cobros reales para todas las tiendas productivas)
MERCADOPAGO_APP_ID=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""

# 2. SANDBOX (Modo prueba exclusivo para tiendas test)
MERCADOPAGO_SANDBOX_APP_ID="1254765898303511"
MERCADOPAGO_SANDBOX_CLIENT_ID="tu_sandbox_client_id"
MERCADOPAGO_SANDBOX_CLIENT_SECRET="tu_sandbox_client_secret"
MERCADOPAGO_SANDBOX_PUBLIC_KEY="tu_sandbox_public_key"
MERCADOPAGO_SANDBOX_ACCESS_TOKEN="tu_sandbox_access_token"

# 3. TIENDAS ASIGNADAS AL ENTORNO SANDBOX (Slugs separados por coma)
MP_SANDBOX_STORES="sandbox"
